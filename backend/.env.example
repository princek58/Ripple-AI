# Ripple AI backend environment configuration template
# Copy this file to backend/.env and populate configuration values.
# Never commit backend/.env.

PORT=4000
NODE_ENV=development
DB_PATH=data/ripple.db
STORAGE_PATH=storage
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JSON_BODY_LIMIT=1mb
MAX_ZIP_SIZE_BYTES=52428800
MAX_FILES_COUNT=5000
MAX_UNCOMPRESSED_SIZE_BYTES=209715200
MAX_SINGLE_FILE_SIZE_BYTES=5242880
GITHUB_CODELOAD_BASE=https://codeload.github.com

# AI Settings (Provider-neutral)
# Provider options: "gemini" | "openai_compatible" (default: "gemini")
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=
AI_API_BASE=

# Legacy / fallback Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE=

# AI Rate Limiting & Limits
AI_RATE_PER_MINUTE=10
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_CHARS=4000
