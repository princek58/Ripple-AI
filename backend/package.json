    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "yazl": "^3.3.1"
  }
}
